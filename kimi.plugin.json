{
  "name": "desk-pet",
  "version": "0.6.0",
  "description": "桌面宠物：在桌面上养一只会互动的 AI 桌宠。它是 Kimi Code 任务状态的外显——思考中浅蓝、工作中蓝光呼吸、本轮结束亮琥珀色「待复核」、出错亮红并安慰你；点击宠物即可聚焦回 Kimi Code 窗口",
  "author": "Chorylee7",
  "homepage": "https://github.com/Chorylee7/kimi-desk-pet",
  "license": "Apache-2.0",
  "keywords": ["pet", "desktop-pet", "desk-pet", "桌宠", "桌面宠物", "electron"],
  "interface": {
    "displayName": "Desk Pet · 桌面宠物",
    "shortDescription": "在桌面上养一只会互动的 AI 桌宠",
    "longDescription": "常驻桌面的 Electron 宠物：猫/狗/史莱姆/兔/外星人/拼豆鸭多种形象，可拖拽、随机走动、点击互动。\n\n任务状态外显：Kimi Code 思考中亮浅蓝、干活时亮蓝并让机器人目镜发光呼吸，本轮结束进入琥珀色「待复核」（点宠物清除），失败变红并安慰你，后台任务完成会提醒你。\n\n点击宠物即可把 Kimi Code 窗口带到前台（可在设置里改为互动模式）。agent 也可以通过 MCP 工具让它说话、做表情、走到指定位置、切换形象。多会话共享同一只宠物。",
    "developerName": "Chorylee7",
    "websiteURL": "https://github.com/Chorylee7/kimi-desk-pet"
  },
  "skills": "./skills/",
  "mcpServers": {
    "desk-pet": {
      "command": "sh",
      "args": ["./mcp/run-node.sh", "./mcp/server.mjs"]
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "sh ./mcp/run-node.sh ./mcp/hooks/notify.mjs",
      "timeout": 20
    },
    {
      "event": "TurnStarted",
      "command": "sh ./mcp/run-node.sh ./mcp/hooks/notify.mjs",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "command": "sh ./mcp/run-node.sh ./mcp/hooks/notify.mjs",
      "timeout": 10
    },
    {
      "event": "Stop",
      "command": "sh ./mcp/run-node.sh ./mcp/hooks/notify.mjs",
      "timeout": 10
    },
    {
      "event": "StopFailure",
      "command": "sh ./mcp/run-node.sh ./mcp/hooks/notify.mjs",
      "timeout": 10
    },
    {
      "event": "Interrupt",
      "command": "sh ./mcp/run-node.sh ./mcp/hooks/notify.mjs",
      "timeout": 10
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "Bash",
      "command": "sh ./mcp/run-node.sh ./mcp/hooks/notify.mjs",
      "timeout": 10
    },
    {
      "event": "Notification",
      "matcher": "task\\.completed",
      "command": "sh ./mcp/run-node.sh ./mcp/hooks/notify.mjs",
      "timeout": 10
    }
  ]
}
